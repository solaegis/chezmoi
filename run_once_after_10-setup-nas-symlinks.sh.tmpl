#!/opt/homebrew/bin/bash

# Sets up symlinks from standard home-dir locations to NAS paths.
# NAS is mounted via macOS autofs (NFS) at /nas/media and /nas/users.
# Designed to be idempotent: skips correct symlinks, warns on real directories.

{{- if eq .chezmoi.os "darwin" }}

set -euo pipefail

MEDIA_MOUNT="/nas/media"
USERS_MOUNT="/nas/users"

log()  { echo "[nas-symlinks] $*"; }
warn() { echo "[nas-symlinks] WARNING: $*" >&2; }

make_symlink() {
    local target="$1"
    local link="$2"

    if [ -L "$link" ]; then
        current_target=$(readlink "$link")
        if [ "$current_target" = "$target" ]; then
            log "OK: $link → $target"
            return 0
        else
            log "Updating: $link → $target (was $current_target)"
            rm "$link"
        fi
    elif [ -e "$link" ]; then
        warn "$link exists as a real directory — skipping."
        warn "  Migrate with: mv '$link' '${link}.bak' then re-run chezmoi apply"
        return 0
    fi

    ln -s "$target" "$link"
    log "Created: $link → $target"
}

# Wake autofs so mounts are available
ls "$MEDIA_MOUNT" &>/dev/null || { warn "$MEDIA_MOUNT not available — is the NAS reachable?"; exit 1; }
ls "$USERS_MOUNT" &>/dev/null || { warn "$USERS_MOUNT not available — is the NAS reachable?"; exit 1; }

make_symlink "${MEDIA_MOUNT}/libation"         "${HOME}/Libation"
make_symlink "${MEDIA_MOUNT}/calibre"          "${HOME}/Calibre Library"
make_symlink "${USERS_MOUNT}/imazing"          "${HOME}/Library/Application Support/iMazing"

log "Done."

{{- else }}
echo "nas-symlinks: skipping (not macOS)"
{{- end }}
