#!/bin/bash

# Sets up symlinks from standard home-dir locations to NAS SMB shares.
# Designed to be idempotent: skips targets that are already correct symlinks,
# warns (but does not overwrite) real directories that have local content.

{{- if eq .chezmoi.os "darwin" }}

set -euo pipefail

NAS_HOST="nas.home.solaegis.com"
MEDIA_SHARE="data_media"
USERS_SHARE="data_users"
MEDIA_MOUNT="/Volumes/data_media"
USERS_MOUNT="/Volumes/data_users"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

log()  { echo "[nas-symlinks] $*"; }
warn() { echo "[nas-symlinks] WARNING: $*" >&2; }

ensure_mounted() {
    local share="$1" mountpoint="$2"
    if mount | grep -q "$mountpoint"; then
        log "$share already mounted at $mountpoint"
        return 0
    fi
    log "Mounting smb://${NAS_HOST}/${share} → ${mountpoint} ..."
    mkdir -p "$mountpoint"
    if ! mount_smbfs "//$(whoami)@${NAS_HOST}/${share}" "$mountpoint" 2>/dev/null; then
        warn "Could not mount ${share} automatically (requires GUI session)."
        warn "Mount it manually first:"
        warn "  open smb://${NAS_HOST}/${share}"
        warn "Then re-run: chezmoi apply"
        return 1
    fi
}

make_symlink() {
    local target="$1"   # NAS path, e.g. /Volumes/data_media/libation
    local link="$2"     # Local path, e.g. ~/Libation

    if [ -L "$link" ]; then
        current_target=$(readlink "$link")
        if [ "$current_target" = "$target" ]; then
            log "Symlink already correct: $link → $target"
            return 0
        else
            log "Updating symlink: $link → $target (was $current_target)"
            rm "$link"
        fi
    elif [ -e "$link" ]; then
        warn "$link exists as a real file/directory — skipping."
        warn "  To migrate: mv '$link' '${link}.bak' then re-run chezmoi apply"
        return 0
    fi

    ln -s "$target" "$link"
    log "Created: $link → $target"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

FAILED_MOUNTS=0

ensure_mounted "$MEDIA_SHARE" "$MEDIA_MOUNT" || FAILED_MOUNTS=$((FAILED_MOUNTS + 1))
ensure_mounted "$USERS_SHARE" "$USERS_MOUNT" || FAILED_MOUNTS=$((FAILED_MOUNTS + 1))

if [ "$FAILED_MOUNTS" -gt 0 ]; then
    warn "$FAILED_MOUNTS share(s) could not be mounted. Symlinks for those shares were skipped."
    warn "Mount the shares and re-run: chezmoi apply"
fi

# Media share symlinks (skip if mount failed)
if mount | grep -q "$MEDIA_MOUNT"; then
    make_symlink "${MEDIA_MOUNT}/libation"  "${HOME}/Libation"
    make_symlink "${MEDIA_MOUNT}/calibre"   "${HOME}/Calibre Library"
fi

# Users share symlinks (skip if mount failed)
if mount | grep -q "$USERS_MOUNT"; then
    log "iMazing NAS path: ${USERS_MOUNT}/lvavasour/imazing"
    log "  Configure iMazing manually: Preferences → Storage → change backup location to above path"
fi

log "Done."

{{- else }}
echo "nas-symlinks: skipping (not macOS)"
{{- end }}
