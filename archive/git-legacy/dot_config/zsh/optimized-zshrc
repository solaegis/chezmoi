# ============================================================================
# 11. COMMAND EXECUTION TIMING
# ============================================================================

# Monitor command execution time
preexec() {
  timer=${timer:-$SECONDS}
}

precmd() {
  if [ $timer ]; then
    local elapsed=$(($SECONDS - $timer))
    if [ $elapsed -gt 5 ]; then
      echo "⏱️  Command took ${elapsed}s"
    fi
    unset timer
  fi
}

