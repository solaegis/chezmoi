# Copy to mcp.env after creating a Wiz MCP integration (Connect to Wiz → Integrations → search "mcp").
# Then: chmod 600 mcp.env && chezmoi add --encrypt ~/.config/wiz/mcp.env
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_API_URL=https://api.us2.app.wiz.io/graphql
WIZ_AUTH_URL=https://auth.app.wiz.io/oauth/token
WIZ_MCP_URL=https://mcp.app.wiz.io
# Local container fallback only (optional):
WIZ_MCP_TRANSPORT=http
WIZ_MCP_HOST=0.0.0.0
WIZ_MCP_PORT=8000
