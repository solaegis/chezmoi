# ============================================================================
# Homebrew Brewfile - Package Management
# ============================================================================
# This file defines all packages to be installed via Homebrew
# Generated for {{ .chezmoi.hostname }} machine
# ============================================================================

# Fonts for icons and better terminal experience
cask "font-hack-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-meslo-lg-nerd-font"

# Essential CLI tools (always installed)
brew "git"
brew "curl"
brew "wget"
brew "vim"
brew "direnv"
brew "jq"
brew "ripgrep"
brew "bat"
brew "eza"
brew "htop"
brew "tree"
brew "uv"  # Modern Python package installer

# Development tools
{{- if (index . "install_dev_tools") }}
brew "go"
brew "python3"
brew "node"
brew "rust"
{{- end }}

# Work-specific packages
{{- $isWork := false -}}
{{- if hasKey . "is_work" -}}
{{-   $isWork = .is_work -}}
{{- else -}}
{{-   $isWork = or (contains "work" .chezmoi.hostname) (contains "corp" .chezmoi.hostname) (contains "company" .chezmoi.hostname) (contains "office" .chezmoi.hostname) -}}
{{- end -}}
{{- if $isWork }}
brew "terraform"
brew "terraform-docs"
brew "google-cloud-sdk"
brew "awscli"
brew "kubectl"
brew "helm"
# Work-specific development tools
brew "docker"
brew "docker-compose"
brew "k9s"
brew "stern"
{{- else }}
# Personal-specific packages
brew "yt-dlp"
# Personal development tools
brew "gh"
brew "glow"
brew "fzf"
brew "zoxide"
{{- end }}

# Optional packages (can be enabled via configuration)
{{- if (index . "install_media_tools") }}
brew "ffmpeg"
brew "imagemagick"
{{- end }}

{{- if (index . "install_gaming_tools") }}
brew "steam"
brew "discord"
{{- end }}
