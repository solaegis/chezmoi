# ============================================================================
# .zshenv - Environment variables for ALL shells (interactive and non-interactive)
# ============================================================================
# This file is ALWAYS sourced by zsh. Keep it minimal and fast.
# Only put variables that are needed by ALL programs, including scripts.

# Essential PATH - only core system paths that all programs need
export HOMEBREW_PREFIX="/opt/homebrew"
export PATH="$HOME/bin:${HOMEBREW_PREFIX}/bin:/usr/local/sbin:$PATH"

# Essential environment variables needed by all programs
export EDITOR="code"
export PAGER="less"
export BROWSER="open"

# Go environment (needed by go tools even in non-interactive shells)
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"

# Rust/Cargo environment (needed by cargo tools in all shells)
# Note: Only source if file exists and avoid console output
if [[ -f "$HOME/.cargo/env" ]]; then
  source "$HOME/.cargo/env"
fi

